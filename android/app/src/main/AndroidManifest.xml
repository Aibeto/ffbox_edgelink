<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 实时活动通知：通知权限（Android 13+ 运行时申请）、提升权限（Android 16 Live Updates）与前台服务 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 内置 FFBox 服务需读取用户选择的视频/媒体文件进行转码。
         内置 Node 后端只能按真实路径读文件（无法读 SAF URI），故需“所有文件访问权”：
         - API 30+ 用 MANAGE_EXTERNAL_STORAGE（经系统“所有文件访问”设置页授权）；
         - API 23-29 用 READ_EXTERNAL_STORAGE（运行时申请，maxSdkVersion 32 覆盖
           API 30-32 已由 MANAGE_EXTERNAL_STORAGE 涵盖）。 -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- usesCleartextTraffic：后端为 HTTP 明文（非 HTTPS），Android 9+ 默认拦截。
         原生前台服务的 HttpURLConnection 轮询/按钮调用依赖此配置放行明文流量
         （Dart 端走 Flutter engine 不受此限制，故登录/列表正常，仅通知轮询失败）。 -->
    <application
        android:label="FFBox EdgeLink"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="false">
        <!-- 实时活动前台服务：dataSync 类型，轮询任务进度并更新 Live Updates 通知 -->
        <service
            android:name=".live.LiveTaskService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- 内置 FFBox 服务前台服务：dataSync 类型，承载 nodejs-mobile 引擎与本机后端 -->
        <service
            android:name=".localnode.LocalNodeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"
            />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>